<mxfile host="app.diagrams.net" type="device"><diagram id="sda-place-bid" name="SDA workflow — place a bid"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="SDA Workflow — Place a Bid" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="600" height="30" as="geometry"/></mxCell><mxCell id="v2" value="SurplusBid backend · POST /api/v1/lots/:id/bids · steps ①–⑬ follow one request from the buyer to PostgreSQL and back" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#475569;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="38" width="800" height="22" as="geometry"/></mxCell><mxCell id="v3" value="CLIENT" style="swimlane;horizontal=0;startSize=34;html=1;whiteSpace=wrap;collapsible=0;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#FFFFFF;fillColor=#334155;swimlaneFillColor=#F8FAFC;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="800" height="110" as="geometry"/></mxCell><mxCell id="v4" value="API / EXPRESS APP" style="swimlane;horizontal=0;startSize=34;html=1;whiteSpace=wrap;collapsible=0;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#FFFFFF;fillColor=#1D4ED8;swimlaneFillColor=#EFF6FF;strokeColor=#1D4ED8;" vertex="1" parent="1"><mxGeometry x="20" y="180" width="800" height="120" as="geometry"/></mxCell><mxCell id="v5" value="ROUTE + MIDDLEWARE" style="swimlane;horizontal=0;startSize=34;html=1;whiteSpace=wrap;collapsible=0;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#FFFFFF;fillColor=#4338CA;swimlaneFillColor=#EEF2FF;strokeColor=#4338CA;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="800" height="152" as="geometry"/></mxCell><mxCell id="v6" value="CONTROLLER" style="swimlane;horizontal=0;startSize=34;html=1;whiteSpace=wrap;collapsible=0;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#FFFFFF;fillColor=#6D28D9;swimlaneFillColor=#F5F3FF;strokeColor=#6D28D9;" vertex="1" parent="1"><mxGeometry x="20" y="452" width="800" height="100" as="geometry"/></mxCell><mxCell id="v7" value="SERVICE · BUSINESS LOGIC" style="swimlane;horizontal=0;startSize=34;html=1;whiteSpace=wrap;collapsible=0;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#FFFFFF;fillColor=#047857;swimlaneFillColor=#ECFDF5;strokeColor=#047857;" vertex="1" parent="1"><mxGeometry x="20" y="552" width="800" height="308" as="geometry"/></mxCell><mxCell id="v8" value="DATA LAYER" style="swimlane;horizontal=0;startSize=34;html=1;whiteSpace=wrap;collapsible=0;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#FFFFFF;fillColor=#B45309;swimlaneFillColor=#FFFBEB;strokeColor=#B45309;" vertex="1" parent="1"><mxGeometry x="20" y="860" width="800" height="150" as="geometry"/></mxCell><mxCell id="v9" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:13px;color:#0F172A&quot;&gt;① Buyer clicks “Place bid”&lt;/b&gt;&lt;div style=&quot;color:#334155;margin-top:3px;line-height:1.3&quot;&gt;&lt;span style=&quot;font-family:Courier New;font-size:11px;color:#0F172A&quot;&gt;POST /api/v1/lots/{lotId}/bids&lt;br&gt;Authorization: Bearer &amp;lt;access JWT&amp;gt;&lt;br&gt;{ &quot;amountCents&quot;: 1250000 }&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="84" width="330" height="84" as="geometry"/></mxCell><mxCell id="v10" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:13px;color:#0F172A&quot;&gt;⑬ Buyer sees the result&lt;/b&gt;&lt;div style=&quot;color:#334155;margin-top:3px;line-height:1.3&quot;&gt;201 → the lot card shows “You are the highest bidder”&lt;br&gt;4xx / 5xx → the app shows &lt;i&gt;message&lt;/i&gt; from the error body&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="470" y="84" width="330" height="84" as="geometry"/></mxCell><mxCell id="v11" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:13px;color:#0F172A&quot;&gt;② Express app receives the request&lt;/b&gt;&lt;div style=&quot;color:#334155;margin-top:3px;line-height:1.3&quot;&gt;app.ts: helmet · CORS (frontend origin) · express.json()&lt;br&gt;Global rate limit: 300 requests / 15 min per client IP&lt;br&gt;Router: /api/v1/lots → bids.routes.ts&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="194" width="330" height="92" as="geometry"/></mxCell><mxCell id="v12" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:12px;color:#0F172A&quot;&gt;errorHandler&lt;/b&gt;&lt;div style=&quot;color:#334155;margin-top:3px;line-height:1.3&quot;&gt;ApiError / Prisma error&lt;br&gt;→ &lt;span style=&quot;font-family:Courier New;font-size:11px;color:#0F172A&quot;&gt;{ success: false,&lt;br&gt;message, errors }&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontFamily=Helvetica;fontSize=11;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="470" y="194" width="150" height="92" as="geometry"/></mxCell><mxCell id="v13" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:12px;color:#0F172A&quot;&gt;⑫ HTTP 201 Created&lt;/b&gt;&lt;div style=&quot;color:#334155;margin-top:3px;line-height:1.3&quot;&gt;&lt;span style=&quot;font-family:Courier New;font-size:11px;color:#0F172A&quot;&gt;{ success: true,&lt;br&gt;message: &quot;Bid placed&quot;,&lt;br&gt;data: bid }&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontFamily=Helvetica;fontSize=11;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="632" y="194" width="168" height="92" as="geometry"/></mxCell><mxCell id="v14" value="&lt;div style=&quot;text-align:left&quot;&gt;③a authenticate — verify JWT, set req.user&lt;/div&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#4338CA;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="314" width="330" height="26" as="geometry"/></mxCell><mxCell id="v15" value="401" style="rounded=1;arcSize=40;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontStyle=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#991B1B;" vertex="1" parent="1"><mxGeometry x="350" y="318" width="44" height="18" as="geometry"/></mxCell><mxCell id="v16" value="&lt;div style=&quot;text-align:left&quot;&gt;③b requireRole('BUYER') — role check (RBAC)&lt;/div&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#4338CA;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="346" width="330" height="26" as="geometry"/></mxCell><mxCell id="v17" value="403" style="rounded=1;arcSize=40;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontStyle=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#991B1B;" vertex="1" parent="1"><mxGeometry x="350" y="350" width="44" height="18" as="geometry"/></mxCell><mxCell id="v18" value="&lt;div style=&quot;text-align:left&quot;&gt;③c bidRateLimit — &lt;span style=&quot;background-color:#FEE2E2;color:#991B1B;font-size:10px;font-weight:bold;padding:0 3px;border-radius:3px&quot;&gt;&amp;nbsp;Redis&amp;nbsp;&lt;/span&gt; max 5 bids/min/lot&lt;/div&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#4338CA;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="378" width="330" height="26" as="geometry"/></mxCell><mxCell id="v19" value="429" style="rounded=1;arcSize=40;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontStyle=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#991B1B;" vertex="1" parent="1"><mxGeometry x="350" y="382" width="44" height="18" as="geometry"/></mxCell><mxCell id="v20" value="&lt;div style=&quot;text-align:left&quot;&gt;③d validate(placeBidSchema) — Zod body check&lt;/div&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#4338CA;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="410" width="330" height="26" as="geometry"/></mxCell><mxCell id="v21" value="422" style="rounded=1;arcSize=40;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontStyle=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#991B1B;" vertex="1" parent="1"><mxGeometry x="350" y="414" width="44" height="18" as="geometry"/></mxCell><mxCell id="v22" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Route definition&lt;/b&gt; (bids.routes.ts)&lt;br&gt;&lt;span style=&quot;font-family:Courier New;font-size:11px;color:#0F172A&quot;&gt;router.post('/:id/bids',&lt;br&gt;&amp;nbsp;&amp;nbsp;authenticate,&lt;br&gt;&amp;nbsp;&amp;nbsp;requireRole('BUYER'),&lt;br&gt;&amp;nbsp;&amp;nbsp;bidRateLimit,&lt;br&gt;&amp;nbsp;&amp;nbsp;validate(placeBidSchema),&lt;br&gt;&amp;nbsp;&amp;nbsp;bid)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#A5B4FC;dashed=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="470" y="314" width="228" height="124" as="geometry"/></mxCell><mxCell id="v23" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:13px;color:#0F172A&quot;&gt;④ bids.controller.bid()&lt;/b&gt;&lt;div style=&quot;color:#334155;margin-top:3px;line-height:1.3&quot;&gt;Reads :id, req.user.id and amountCents&lt;br&gt;Calls placeBid(); asyncHandler forwards any throw&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#6D28D9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="466" width="330" height="74" as="geometry"/></mxCell><mxCell id="v24" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:13px;color:#0F172A&quot;&gt;⑪ sendSuccess(res, 201, &quot;Bid placed&quot;, bid)&lt;/b&gt;&lt;div style=&quot;color:#334155;margin-top:3px;line-height:1.3&quot;&gt;Wraps the new bid in the standard&lt;br&gt;{ success, message, data } envelope&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#6D28D9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="470" y="466" width="330" height="74" as="geometry"/></mxCell><mxCell id="v25" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:13px;color:#0F172A&quot;&gt;⑤ Check the deposit hold&lt;/b&gt;&lt;div style=&quot;color:#334155;margin-top:3px;line-height:1.3&quot;&gt;&lt;span style=&quot;background-color:#FEF3C7;color:#92400E;font-size:10px;font-weight:bold;padding:0 3px;border-radius:3px&quot;&gt;&amp;nbsp;PostgreSQL&amp;nbsp;&lt;/span&gt; AUTHORIZED hold for this buyer + lot?&lt;br&gt;&lt;span style=&quot;background-color:#FEE2E2;color:#991B1B;font-size:10px;font-weight:bold;padding:0 3px;border-radius:3px&quot;&gt;&amp;nbsp;Redis&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;background-color:#EDE9FE;color:#5B21B6;font-size:10px;font-weight:bold;padding:0 3px;border-radius:3px&quot;&gt;&amp;nbsp;Stripe&amp;nbsp;&lt;/span&gt; card authorization confirmed?&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#047857;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="566" width="330" height="80" as="geometry"/></mxCell><mxCell id="v26" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:13px;color:#0F172A&quot;&gt;⑥ Begin transaction, lock the lot row&lt;/b&gt;&lt;div style=&quot;color:#334155;margin-top:3px;line-height:1.3&quot;&gt;&lt;span style=&quot;background-color:#FEF3C7;color:#92400E;font-size:10px;font-weight:bold;padding:0 3px;border-radius:3px&quot;&gt;&amp;nbsp;PostgreSQL&amp;nbsp;&lt;/span&gt; SET LOCAL lock_timeout = '3000ms'&lt;br&gt;&lt;span style=&quot;font-family:Courier New;font-size:11px;color:#0F172A&quot;&gt;SELECT … FROM &quot;Lot&quot; WHERE id = $1 FOR UPDATE&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#047857;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="664" width="330" height="80" as="geometry"/></mxCell><mxCell id="v27" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:13px;color:#0F172A&quot;&gt;⑦ Apply the auction rules (locked row)&lt;/b&gt;&lt;div style=&quot;color:#334155;margin-top:3px;line-height:1.3&quot;&gt;Lot exists · status = LIVE · endTime not passed&lt;br&gt;amountCents ≥ current price + bid increment&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#047857;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="762" width="330" height="80" as="geometry"/></mxCell><mxCell id="v28" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:13px;color:#0F172A&quot;&gt;⑧ Record the bid&lt;/b&gt;&lt;div style=&quot;color:#334155;margin-top:3px;line-height:1.3&quot;&gt;&lt;span style=&quot;background-color:#FEF3C7;color:#92400E;font-size:10px;font-weight:bold;padding:0 3px;border-radius:3px&quot;&gt;&amp;nbsp;PostgreSQL&amp;nbsp;&lt;/span&gt; previous WINNING bid → OUTBID&lt;br&gt;INSERT Bid with status WINNING&lt;br&gt;&amp;lt; 2 min left → endTime + 2 min (anti-sniping)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#047857;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="470" y="762" width="330" height="80" as="geometry"/></mxCell><mxCell id="v29" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:13px;color:#0F172A&quot;&gt;⑨ Update the lot and the cache&lt;/b&gt;&lt;div style=&quot;color:#334155;margin-top:3px;line-height:1.3&quot;&gt;&lt;span style=&quot;background-color:#FEF3C7;color:#92400E;font-size:10px;font-weight:bold;padding:0 3px;border-radius:3px&quot;&gt;&amp;nbsp;PostgreSQL&amp;nbsp;&lt;/span&gt; UPDATE Lot: highest bid · price ·&lt;br&gt;highest bidder · endTime&lt;br&gt;&lt;span style=&quot;background-color:#FEE2E2;color:#991B1B;font-size:10px;font-weight:bold;padding:0 3px;border-radius:3px&quot;&gt;&amp;nbsp;Redis&amp;nbsp;&lt;/span&gt; SET lot:{id}:highestBid&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#047857;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="470" y="664" width="330" height="80" as="geometry"/></mxCell><mxCell id="v30" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:13px;color:#0F172A&quot;&gt;⑩ COMMIT, return the new bid&lt;/b&gt;&lt;div style=&quot;color:#334155;margin-top:3px;line-height:1.3&quot;&gt;Row lock released; the next queued bid&lt;br&gt;re-reads the new price before it is checked&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#047857;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="470" y="566" width="330" height="80" as="geometry"/></mxCell><mxCell id="v31" value="403" style="rounded=1;arcSize=40;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontStyle=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#991B1B;" vertex="1" parent="1"><mxGeometry x="350" y="572" width="46" height="18" as="geometry"/></mxCell><mxCell id="v32" value="503" style="rounded=1;arcSize=40;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontStyle=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#991B1B;" vertex="1" parent="1"><mxGeometry x="350" y="670" width="46" height="18" as="geometry"/></mxCell><mxCell id="v33" value="404/409" style="rounded=1;arcSize=40;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontStyle=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#991B1B;" vertex="1" parent="1"><mxGeometry x="334" y="768" width="62" height="18" as="geometry"/></mxCell><mxCell id="v34" value="&lt;b&gt;Prisma ORM&lt;/b&gt; (src/config/prisma.ts) — typed queries · $transaction · raw SQL for FOR UPDATE" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.5;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="70" y="872" width="550" height="26" as="geometry"/></mxCell><mxCell id="v35" value="&lt;b style=&quot;font-size:13px&quot;&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;DepositHold (read) · Lot (row lock + update) · Bid (update + insert)&lt;br&gt;ReadCommitted transaction · 8 s budget · 3 s lock wait" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fontFamily=Helvetica;fontSize=12;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.5;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="70" y="906" width="550" height="96" as="geometry"/></mxCell><mxCell id="v36" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;rate-limit counters · hold-confirmed flag · highest-bid cache (③c ⑤ ⑨)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="640" y="872" width="160" height="62" as="geometry"/></mxCell><mxCell id="v37" value="&lt;b&gt;Stripe API&lt;/b&gt;&lt;br&gt;deposit PaymentIntent status (⑤)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="640" y="940" width="160" height="62" as="geometry"/></mxCell><mxCell id="e38" value="" style="html=1;rounded=1;strokeWidth=2;strokeColor=#2563EB;endArrow=block;endFill=1;endSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="v9" target="v11"><mxGeometry relative="1" as="geome