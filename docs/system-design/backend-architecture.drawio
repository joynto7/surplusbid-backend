one;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#16A34A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="132" width="70" height="20" as="geometry"/></mxCell><mxCell id="e33" value="" style="html=1;rounded=1;strokeWidth=1.5;strokeColor=#DC2626;dashed=1;endArrow=block;endFill=1;endSize=6;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.8061;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="v14" target="v4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="22" y="625"/><mxPoint x="22" y="239"/></Array></mxGeometry></mxCell><mxCell id="v34" value="thrown errors" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#DC2626;fontStyle=1;horizontal=0;" vertex="1" parent="1"><mxGeometry x="0" y="380" width="20" height="130" as="geometry"/></mxCell><mxCell id="v35" value="&lt;b&gt;Google OAuth&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#475569&quot;&gt;Passport strategy: sign-in and account creation&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#0F172A;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="640" y="170" width="190" height="56" as="geometry"/></mxCell><mxCell id="e36" value="" style="html=1;rounded=1;strokeWidth=1.2;strokeColor=#64748B;dashed=1;endArrow=open;endFill=0;endSize=6;exitX=1;exitY=0.3878;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="v4" target="v35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v37" value="&lt;b&gt;Cloudinary&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#475569&quot;&gt;lot images and verification documents&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#F8FAFC;strokeColor=#