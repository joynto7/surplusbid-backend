;" edge="1" parent="1" source="t_Lot_r3" target="t_Category_r0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v348" value="&lt;b style=&quot;font-size:14px&quot;&gt;Enums&lt;/b&gt;&lt;br&gt;&lt;b&gt;Role&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#475569&quot;&gt;BUYER · SELLER · ADMIN&lt;/span&gt;&lt;br&gt;&lt;b&gt;AuthProvider&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#475569&quot;&gt;LOCAL · GOOGLE&lt;/span&gt;&lt;br&gt;&lt;b&gt;VerificationStatus&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#475569&quot;&gt;UNVERIFIED · PENDING · VERIFIED · REJECTED&lt;/span&gt;&lt;br&gt;&lt;b&gt;LotStatus&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#475569&quot;&gt;DRAFT · LIVE · ENDED · SOLD · UNSOLD · CANCELLED&lt;/span&gt;&lt;br&gt;&lt;b&gt;BidStatus&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#475569&quot;&gt;ACTIVE · OUTBID · WINNING&lt;/span&gt;&lt;br&gt;&lt;b&gt;HoldStatus&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#475569&quot;&gt;AUTHORIZED · CAPTURED · RELEASED · FAILED&lt;/span&gt;&lt;br&gt;&lt;b&gt;PaymentStatus&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#475569&quot;&gt;PENDING · SUCCEEDED · FAILED · REFUNDED&lt;/span&gt;&lt;br&gt;&lt;b&gt;DisputeStatus&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#475569&quot;&gt;OPEN · UNDER_REVIEW · RESOLVED · REJECTED&lt;/span&gt;&lt;br&gt;&lt;b&gt;MessageStatus&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#475569&quot;&gt;NEW · READ · ARCHIVED&lt;/span&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=12;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="1120" y="740" width="320" height="318" as="geometry"/></mxCell><mxCell id="v349" value="&lt;b style=&quot;font-size:14px&quot;&gt;Key indexes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#334155&quot;&gt;Lot (status, endTime) · close-lots job&lt;br&gt;Lot (categoryId, status) · browse&lt;br&gt;Lot (status, currentPriceCents) · price sort&lt;br&gt;Bid (lotId, createdAt) · bid history&lt;br&gt;Payment (status, dueAt) · deadline sweep&lt;br&gt;Review (sellerId, createdAt)&lt;br&gt;LotView (lotId, createdAt)&lt;br&gt;Trigger lot_current_price keeps&lt;br&gt;currentPriceCents = COALESCE(bid, start)&lt;/span&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=12;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="300" height="180" as="geometry"/></mxCell><mxCell id="v350" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="1680" y="860" width="280" height="560" as="geometry"/></mxCell><mxCell id="v351" value="Legend" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1694" y="868" width="200" height="24" as="geometry"/></mxCell><mxCell id="e352" value="" style="html=1;strokeWidth=1.5;strokeColor=#334155;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;startSize=10;endSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1784" y="908" as="sourcePoint"/><mxPoint x="1696" y="908" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v353" value="one-to-many, FK required" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#334155;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1792" y="898" width="165" height="20" as="geometry"/></mxCell><mxCell id="e354" value="" style="html=1;strokeWidth=1.5;strokeColor=#334155;startArrow=ERzeroToMany;endArrow=ERzeroToOne;startFill=0;endFill=0;startSize=10;endSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1784" y="938" as="sourcePoint"/><mxPoint x="1696" y="938" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v355" value="one-to-many, FK optional" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#334155;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1792" y="928" width="165" height="20" as="geometry"/></mxCell><mxCell id="v356" value="&lt;b&gt;PK&lt;/b&gt; primary key · &lt;b&gt;FK&lt;/b&gt; foreign key&lt;br&gt;&lt;b&gt;UQ&lt;/b&gt; unique · &lt;b&gt;?&lt;/b&gt; nullable&lt;br&gt;&lt;br&gt;Each line runs from an FK column to the &lt;b&gt;id&lt;/b&gt; it references. Line colour = table referenced: &lt;span style='color:#2563EB'&gt;&lt;b&gt;User&lt;/b&gt;&lt;/span&gt; · &lt;span style='color:#D97706'&gt;&lt;b&gt;Lot&lt;/b&gt;&lt;/span&gt; · &lt;span style='color:#16A34A'&gt;&lt;b&gt;Category&lt;/b&gt;&lt;/span&gt;. Required FKs join User.id from the right, optional ones from the left.&lt;br&gt;&lt;br&gt;&lt;b&gt;Many-to-many&lt;/b&gt;: User ⟷ Lot is resolved by Bid, DepositHold, Payment, Review, Dispute and LotView.&lt;br&gt;&lt;br&gt;&lt;b&gt;One per pair&lt;/b&gt;: UNIQUE (lotId, buyerId) gives one deposit hold per buyer per lot; UNIQUE (lotId, authorId) gives one review per buyer per lot.&lt;br&gt;&lt;br&gt;IDs are UUID v4 strings; money is integer cents (USD); soft deletes use deletedAt." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="1694" y="972" width="254" height="300" as="geometry"/></mxCell><mxCell id="v357" value="" style="rounded=0;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1696" y="1288" width="22" height="16" as="geometry"/></mxCell><mxCell id="v358" value="Identity &amp; audit" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#334155;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1728" y="1285" width="220" height="22" as="geometry"/></mxCell><mxCell id="v359" value="" style="rounded=0;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1696" y="1312" width="22" height="16" as="geometry"/></mxCell><mxCell id="v360" value="Catalogue" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#334155;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1728" y="1309" width="220" height="22" as="geometry"/></mxCell><mxCell id="v361" value="" style="rounded=0;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1696" y="1336" width="22" height="16" as="geometry"/></mxCell><mxCell id="v362" value="Bids, holds &amp; payments" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#334155;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1728" y="1333" width="220" height="22" as="geometry"/></mxCell><mxCell id="v363" value="" style="rounded=0;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1696" y="1360" width="22" height="16" as="geometry"/></mxCell><mxCell id="v364" value="Reviews &amp; disputes" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#334155;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1728" y="1357" width="220" height="22" as="geometry"/></mxCell><mxCell id="v365" value="" style="rounded=0;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1696" y="1384" width="22" height="16" as="geometry"/></mxCell><mxCell id="v366" value="Activity tracking" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#334155;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1728" y="1381" width="220" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
