<mxfile host="app.diagrams.net" type="device"><diagram id="backend-architecture" name="Backend architecture"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="Backend Architecture — SurplusBid API" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="700" height="30" as="geometry"/></mxCell><mxCell id="v2" value="Client → API → Route → Controller → Service → Repository / ORM → Database · chips mark where auth, validation and error handling run" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#475569;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="38" width="780" height="22" as="geometry"/></mxCell><mxCell id="v3" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:14px;color:#0F172A&quot;&gt;Clients&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#64748B;font-size:11px&quot;&gt;HTTPS · JSON · Authorization: Bearer &amp;lt;JWT&amp;gt;&lt;/span&gt;&lt;div style=&quot;color:#334155;margin-top:3px;line-height:1.35&quot;&gt;Next.js web app (BFF: buyer, seller, admin UI) · Postman / API clients · Stripe webhooks&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=7;fontFamily=Helvetica;fontSize=12;fillColor=#F8FAFC;strokeColor=#334155;strokeWidth=1.8;" vertex="1" parent="1"><mxGeometry x="40" y="74" width="560" height="54" as="geometry"/></mxCell><mxCell id="v4" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:14px;color:#0F172A&quot;&gt;API layer — Express 5&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#64748B;font-size:11px&quot;&gt;src/app.ts · src/server.ts&lt;/span&gt;&lt;div style=&quot;color:#334155;margin-top:3px;line-height:1.35&quot;&gt;helmet · CORS (frontend origin) · express.json(), raw body kept for /payments/webhook&lt;br&gt;global rate limit 300 req / 15 min · Passport (Google OAuth) · module routers under /api/v1&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=7;fontFamily=Helvetica;fontSize=12;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=1.8;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="560" height="98" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;ERRORS&lt;/b&gt; · errorHandler, mounted last → { success: false }" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#991B1B;" vertex="1" parent="1"><mxGeometry x="52" y="228" width="320" height="22" as="geometry"/></mxCell><mxCell id="v6" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:14px;color:#0F172A&quot;&gt;Route layer&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#64748B;font-size:11px&quot;&gt;src/modules/&amp;lt;module&amp;gt;/&amp;lt;module&amp;gt;.routes.ts&lt;/span&gt;&lt;div style=&quot;color:#334155;margin-top:3px;line-height:1.35&quot;&gt;13 modules: auth · users · categories · lots · bids · payments · disputes · reviews · sellers · stats · contact + newsletter · ai · admin. Each route = path + middleware chain + controller.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=7;fontFamily=Helvetica;fontSize=12;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=1.8;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="560" height="124" as="geometry"/></mxCell><mxCell id="v7" value="&lt;b&gt;AUTH&lt;/b&gt; · authenticate / optionalAuth (JWT)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#E0E7FF;strokeColor=#4338CA;fontColor=#312E81;" vertex="1" parent="1"><mxGeometry x="52" y="361" width="262" height="22" as="geometry"/></mxCell><mxCell id="v8" value="&lt;b&gt;AUTH&lt;/b&gt; · requireRole('BUYER' | 'SELLER' | 'ADMIN')" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#E0E7FF;strokeColor=#4338CA;fontColor=#312E81;" vertex="1" parent="1"><mxGeometry x="322" y="361" width="266" height="22" as="geometry"/></mxCell><mxCell id="v9" value="&lt;b&gt;VALIDATION&lt;/b&gt; · validate(zodSchema) on the body" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#CCFBF1;strokeColor=#0F766E;fontColor=#134E4A;" vertex="1" parent="1"><mxGeometry x="52" y="388" width="262" height="22" as="geometry"/></mxCell><mxCell id="v10" value="&lt;b&gt;&lt;/b&gt;Redis rate limits · Multer → Cloudinary" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="322" y="388" width="266" height="22" as="geometry"/></mxCell><mxCell id="v11" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:14px;color:#0F172A&quot;&gt;Controller layer&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#64748B;font-size:11px&quot;&gt;*.controller.ts&lt;/span&gt;&lt;div style=&quot;color:#334155;margin-top:3px;line-height:1.35&quot;&gt;Thin HTTP adapters: read params, query, body and req.user → call one service&lt;br&gt;→ reply with sendSuccess(status, message, data)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=7;fontFamily=Helvetica;fontSize=12;fillColor=#F5F3FF;strokeColor=#6D28D9;strokeWidth=1.8;" vertex="1" parent="1"><mxGeometry x="40" y="446" width="560" height="98" as="geometry"/></mxCell><mxCell id="v12" value="&lt;b&gt;VALIDATION&lt;/b&gt; · parseOr422(schema, req.query)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#CCFBF1;strokeColor=#0F766E;fontColor=#134E4A;" vertex="1" parent="1"><mxGeometry x="52" y="514" width="262" height="22" as="geometry"/></mxCell><mxCell id="v13" value="&lt;b&gt;ERRORS&lt;/b&gt; · asyncHandler → next(err)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#991B1B;" vertex="1" parent="1"><mxGeometry x="322" y="514" width="266" height="22" as="geometry"/></mxCell><mxCell id="v14" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:14px;color:#0F172A&quot;&gt;Service layer — business logic&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#64748B;font-size:11px&quot;&gt;*.service.ts · src/jobs&lt;/span&gt;&lt;div style=&quot;color:#334155;margin-top:3px;line-height:1.35&quot;&gt;Auction rules · row-locked bidding · Stripe escrow · settlement and rollover&lt;br&gt;ownership checks · audit log · AI features (Claude, with a built-in fallback)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=7;fontFamily=Helvetica;fontSize=12;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=1.8;" vertex="1" parent="1"><mxGeometry x="40" y="576" width="560" height="98" as="geometry"/></mxCell><mxCell id="v15" value="&lt;b&gt;AUTH&lt;/b&gt; · ownership / party checks (403)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#E0E7FF;strokeColor=#4338CA;fontColor=#312E81;" vertex="1" parent="1"><mxGeometry x="52" y="644" width="262" height="22" as="geometry"/></mxCell><mxCell id="v16" value="&lt;b&gt;RULES&lt;/b&gt; · throw new ApiError(404 | 409 | …)" style="rounded=1;ar